{
  "name": "red_sizzle",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "env:generate": "varlock codegen --path ./apps/web/",
    "postinstall": "varlock codegen --path ./apps/web/"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@red_sizzle/config": "*",
    "@types/node": "^26.4.1",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "varlock": "1.23.0"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}
